# Supabase (Configuration de l'instance de base de données et d'authentification)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anonyme-publique"
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role-privee-a-garder-secrete"

# URL de l'application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Assistance client et contacts officiels
NEXT_PUBLIC_WHATSAPP_SUPPORT="221770000000"

# Numéros marchands de paiement mobile pour Al_Muxtaar_Doc
NEXT_PUBLIC_WAVE_MERCHANT_NUMBER="+221 77 000 00 00"
NEXT_PUBLIC_ORANGE_MONEY_MERCHANT_NUMBER="+221 78 000 00 00"
NEXT_PUBLIC_PAYMENT_BENEFICIARY_NAME="Al Muxtaar Société"

